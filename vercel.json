{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/google8b6400bfc235f3ba.html",
      "destination": "/google8b6400bfc235f3ba.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:dealerSlug/cars",
      "destination": "/:dealerSlug",
      "permanent": true
    }
  ]
}
